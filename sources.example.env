# =====================================================================
# Emplacement des fichiers sources, propre a chaque poste
# ---------------------------------------------------------------------
# Copier ce fichier en sources.env (meme dossier) et remplir les chemins.
# sources.env n'est jamais versionne : il decrit un poste, pas le projet.
#
# Chemin absolu, ou relatif au dossier du depot. Pas de guillemets
# necessaires, meme avec des espaces.
# =====================================================================

# --- TABOO -----------------------------------------------------------

# Dossier des exports du logiciel de caisse : Journal_Vente*.csv,
# Balance par catégorie*.csv, Articles offerts*.csv, INVENTAIRE*.csv...
# Les noms portent l'heure d'export : on les retrouve par leur partie
# stable. Ne garder qu'un export de chaque rapport dans ce dossier.
TABOO_EXPORTS_POS=C:\chemin\vers\exports_caisse_taboo

# Livre de depenses tenu par l'etablissement, exporte en CSV.
TABOO_DEPENSES=C:\chemin\vers\Depenses TABOO - Détail_Dépenses .csv

# Couts de revient par produit (fiches techniques). Sert a TABOO, et a
# AMNESIA qui reprend les couts du meme catalogue.
COUTS_DE_REVIENT=C:\chemin\vers\couts_de_revient.csv

# Nomenclature des achats : catalogue de la feuille de saisie
# (40_feuille_achats.py).
TABOO_NOMENCLATURE=C:\chemin\vers\TABOO_Nomenclature_et_fiches_composition.xlsx

# --- AMNESIA ---------------------------------------------------------

# Dossier des exports Infogest d'AMNESIA (CSV).
AMNESIA_EXPORTS_POS=C:\chemin\vers\exports_infogest_amnesia

# Classeur de suivi mensuel d'AMNESIA.
AMNESIA_CLASSEUR=C:\chemin\vers\AMNESIA_Analyses mensuelles.xlsx
