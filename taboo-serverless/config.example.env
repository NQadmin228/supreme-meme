# =====================================================================
# TABOO — configuration d'instanciation
# =====================================================================
# Copier en config.env et renseigner. config.env est exclu du depot :
# ces valeurs ne donnent pas l'acces, mais elles donnent la cible.
#
#   cp config.example.env config.env
#   $EDITOR config.env
#   python sql/instancier.py        # produit sql/*.instancie.sql
#
# Les fichiers SQL versionnes portent des placeholders. C'est ce qui
# rend ce depot reutilisable pour un autre etablissement, et non
# seulement publiable.

# Projet GCP portant les jeux BigQuery
BQ_PROJET=mon-projet-bigquery

# Region. Ne pas changer sans deplacer BigQuery : une requete ne peut pas
# atteindre un jeu de donnees situe dans une autre region.
BQ_REGION=europe-west1

# Bucket ou arrivent les exports POS et les referentiels
GCS_BUCKET_SOURCES=mon-bucket-exports-pos

# Bucket recevant les instantanes publies et le manifeste
GCS_BUCKET_INSTANTANES=mon-bucket-instantanes

# Disjoncteur d'octets factures par requete (2 Gio par defaut)
BQ_MAX_BYTES_BILLED=2147483648
